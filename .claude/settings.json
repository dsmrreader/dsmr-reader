{
  "effortLevel": "medium",
  "enabledPlugins": {
    "frontend-design@claude-plugins-official": true,
    "superpowers@claude-plugins-official": true,
    "skill-creator@claude-plugins-official": true
  },
  "gitCoAuthorship": false,
  "permissions": {
    "allow": [
      "Bash(poetry run black*)",
      "Bash(poetry run djlint*)",
      "Bash(poetry run mypy /app*)",
      "Bash(poetry run flake8*)",
      "Bash(poetry run pytest*)",
      "Bash(DJANGO_SETTINGS_MODULE=* poetry run pytest*)",
      "Bash(poetry run /app/src/manage.py makemigrations*)",
      "Bash(poetry run /app/src/manage.py migrate*)",
      "Bash(poetry run /app/src/manage.py dsmr_backend*)",
      "Bash(poetry run /app/src/manage.py dsmr_fake_datasource*)",
      "Bash(poetry run /app/src/manage.py dsmrreader_lock_migrations*)",
      "Bash(poetry run /app/src/manage.py development_reset*)",
      "Bash(poetry run /app/src/manage.py dsmr_superuser*)",
      "Bash(git -C /app*)",
      "Bash(git commit*)",
      "Bash(cat *)",
      "Bash(find *)",
      "Bash(grep *)",
      "Bash(ls *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(wc *)",
      "Edit(/app/documentation/*)",
      "Write(/app/documentation/*)"
    ],
    "deny": []
  }
}
